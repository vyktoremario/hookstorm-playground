# Copy to .env and fill in. Never commit .env.
PORT=3000
DATABASE_URL=postgres://shop:shop@127.0.0.1:5433/shop

# Stripe TEST mode only: sk_test_... from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# whsec_... printed by `stripe listen`
STRIPE_WEBHOOK_SECRET=

# Where receipt emails are sent (an email API). Unset = just log them.
# Under Hookstorm this points at the sink: http://127.0.0.1:4400/sink/email
EMAIL_API_URL=

# Test-only routes (/hookstorm/reset, /hookstorm/state). Never set in production.
HOOKSTORM=0
